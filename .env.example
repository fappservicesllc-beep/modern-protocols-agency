# Node 24 loads this file for npm run dev, npm start, and npm run db:migrate.
# Never commit real credentials. Netlify uses its server-side environment settings.

# REQUIRED: standard PostgreSQL URL. Production should use a dedicated database
# and the provider's verified TLS settings; use a pooled URL for Netlify Functions.
DATABASE_URL=

# REQUIRED only for private retrieval: a long random server-only token.
# GET /api/inquiries and GET /api/subscribers require Authorization: Bearer TOKEN.
# If unset, these endpoints return 503; saving new submissions still works.
# Do not prefix this name with VITE_ or place the value in frontend code.
ADMIN_API_TOKEN=

# OPTIONAL: notification email only. Records save even if email is unavailable.
# Existing sender: onboarding@resend.dev; recipient: themodernprotocols@gmail.com.
# Verify a sender/domain in Resend before enabling production notifications.
RESEND_API_KEY=

# Optional local Node HTTP port; Netlify Functions does not use this.
PORT=5173
